# SafeSphere Backend Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB URI or MongoDB Atlas Cluster URI
MONGO_URI=mongodb://127.0.0.1:27017/safesphere

# Security & Authentication
# Replace with a strong random secret key in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Optional Integrations (Leave empty for built-in mock/rule-based fallbacks)
# Twilio SMS Service Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI API Key for AI Safety Assistant
OPENAI_API_KEY=your_openai_api_key_placeholder
